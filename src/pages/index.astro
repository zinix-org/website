---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="home">
    <h1>Better software starts with <br /> complete transparency</h1>
    <p>
      Open-source homelabber and developer tools without any telemetry or cloud
      dependencies.
    </p>
  </div>
</BaseLayout>

<style>
  .home {
    display: flex;
    flex: 1;

    align-items: center;
    justify-content: center;
    text-align: center;
    flex-direction: column;
  }

  p {
    font-size: 1.4em;
    margin: 0 16em;
  }
</style>
